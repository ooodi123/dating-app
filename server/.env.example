# Токен бота от @BotFather. Никогда не коммитьте настоящий .env
BOT_TOKEN=
# HTTPS-адрес, где открыт мини-апп (например, https://your-domain.com). На Bothost берётся из DOMAIN
WEBAPP_URL=
PORT=3000
# Папка для базы, фото и селфи (на хостинге — постоянный диск)
DATA_DIR=data
# Ключ Claude API для AI-фич (без него AI-кнопки отключены)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Telegram id модераторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=
# Только для локальной разработки: вход без Telegram через заголовок "dev <id>"
DEV_AUTH=0
